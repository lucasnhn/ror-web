{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["AUTH_ISSUER", "AUTH_CLIENT_ID", "AUTH_CLIENT_SECRET"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "css/**", "storybook-static/**"],
      "cache": true
    },
    "dev": {
      "persistent": true,
      "outputs": ["dist/**"],
      "cache": false
    },
    "lint": {
      "dependsOn": ["@ror/react#build"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "build:github": {
      "dependsOn": ["^build"],
      "outputs": [".next/**"]
    }
  }
}
