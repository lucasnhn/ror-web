{
  "name": "@ror/design",
  "version": "0.0.6",
  "private": true,
  ".": {
    "import": "./dist/index.css",
    "require": "./dist/index.css"
  },
  "exports": {
    "./style.css": "./dist/index.css"
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "sass src/index.scss dist/index.css",
    "dev": "sass --watch src/index.scss dist/index.css",
    "clean": "rm -rf dist && rm -rf .turbo"
  },
  "devDependencies": {
    "sass": "^1.83.4"
  }
}
