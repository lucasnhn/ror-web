{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "incremental": true,

    "lib": ["es2024"],
    "module": "nodenext",
    "target": "es2024",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node16",
    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,

    "outDir": "dist",
    "rootDir": "./src"
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.tsx", "dist/**/*", "lib/**/*", "node_modules"]
}
