{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "skipLibCheck": true,
    "target": "es6",
    "module": "es6",
    "lib": ["es6", "dom"],
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "./src",
    "strict": true,
    "incremental": true,
    "moduleResolution": "node16",
    "esModuleInterop": false,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": ["src/**/*.spec.tsx", "dist/**/*"]
}
